# Discord bot token — https://discord.com/developers/applications
TOKEN="Discord Bot Token"

# Guild to register slash commands in. Leave empty to register them globally.
GUILD_ID=""

# Your Discord user ID. Enables the owner-only /eval command.
DEV_ID=""

# MongoDB credentials, shared by the bot and the mongo_db container.
MONGO_INITDB_ROOT_USERNAME=root
MONGO_INITDB_ROOT_PASSWORD=admin

# Optional: override the whole MongoDB connection string.
# MONGO_URL="mongodb://root:admin@mongo_db:27017/?authMechanism=DEFAULT"
